@@ -0,0 +1,24 @@
+import '../entidades/pedido.dart';
+import '../entidades/situacao_pedido.dart';
+import '../falhas.dart';
+import '../repositorios/pedido_repositorio.dart';
+
+/// Saída para entrega: o pedido aceito sai antes de ser finalizado.
+class MarcarSaida {
+  final PedidoRepositorio _pedidos;
+
+  MarcarSaida(this._pedidos);
+
+  String? validar(Pedido? pedido) {
+    if (pedido == null || pedido.situacao != SituacaoPedido.aceito) {
+      return 'Somente pedidos aceitos podem sair para entrega.';
+    }
+    return null;
+  }
+
+  Future<void> executar(Pedido? pedido) async {
+    final problema = validar(pedido);
+    if (problema != null) throw FalhaServico(problema);
+    await _pedidos.marcarSaida(pedido!.id);
+  }
+}
