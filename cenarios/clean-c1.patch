diff --git a/b/lib/infra/rota_osrm.dart b/b/lib/infra/rota_osrm.dart
new file mode 100644
index 0000000..43d0077
--- /dev/null
+++ b/b/lib/infra/rota_osrm.dart
@@ -0,0 +1,102 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:http/http.dart' as http;
+
+import '../data/fontes/rota_fonte.dart';
+import '../domain/entidades/coordenada.dart';
+import '../domain/falhas.dart';
+
+/// US11: distância, tempo e rota até o cliente por Nominatim e OSRM (RF16, RNF08).
+class RotaOsrm implements RotaFonte {
+  final http.Client _cliente;
+
+  RotaOsrm(this._cliente);
+
+  static const enderecoDeposito = 'Dona Emma, SC, Brasil';
+  static const _intervaloEntreBuscas = Duration(milliseconds: 1100);
+  static const _tempoLimite = Duration(seconds: 10);
+  static const _cabecalhos = {'User-Agent': 'DiskGasTCC/1.0'};
+  static DateTime _proximaBusca = DateTime.fromMillisecondsSinceEpoch(0);
+
+  Future<void> _aguardarVez() async {
+    final agora = DateTime.now();
+    final vez = _proximaBusca.isAfter(agora) ? _proximaBusca : agora;
+    _proximaBusca = vez.add(_intervaloEntreBuscas);
+    await Future<void>.delayed(vez.difference(agora));
+  }
+
+  Future<Coordenada> _localizar(String endereco) async {
+    await _aguardarVez();
+    final resposta = await _cliente
+        .get(
+          Uri.https('nominatim.openstreetmap.org', '/search', {
+            'format': 'jsonv2',
+            'limit': '1',
+            'countrycodes': 'br',
+            'q': endereco,
+          }),
+          headers: _cabecalhos,
+        )
+        .timeout(_tempoLimite);
+    if (resposta.statusCode != 200) throw const FalhaRota();
+    final lista = jsonDecode(resposta.body);
+    if (lista is! List || lista.isEmpty || lista.first is! Map) {
+      throw const FalhaRota();
+    }
+    final lugar = lista.first as Map;
+    final latitude = double.tryParse('${lugar['lat']}');
+    final longitude = double.tryParse('${lugar['lon']}');
+    if (latitude == null || longitude == null) throw const FalhaRota();
+    return Coordenada(latitude, longitude);
+  }
+
+  @override
+  Future<Map<String, dynamic>> calcular(String destino) async {
+    try {
+      final origem = await _localizar(enderecoDeposito);
+      final chegada = await _localizar('$destino, SC, Brasil');
+      final resposta = await _cliente
+          .get(
+            Uri.parse(
+              'https://router.project-osrm.org/route/v1/driving/'
+              '${origem.longitude},${origem.latitude};'
+              '${chegada.longitude},${chegada.latitude}'
+              '?overview=full&geometries=polyline',
+            ),
+            headers: _cabecalhos,
+          )
+          .timeout(_tempoLimite);
+      if (resposta.statusCode != 200) throw const FalhaRota();
+
+      final corpo = jsonDecode(resposta.body);
+      if (corpo is! Map || corpo['code'] != 'Ok') throw const FalhaRota();
+      final rotas = corpo['routes'];
+      if (rotas is! List || rotas.isEmpty || rotas.first is! Map) {
+        throw const FalhaRota();
+      }
+      final rota = rotas.first as Map;
+      final distancia = rota['distance'];
+      final duracao = rota['duration'];
+      final geometria = rota['geometry'];
+      if (distancia is! num || duracao is! num || geometria is! String) {
+        throw const FalhaRota();
+      }
+
+      return {
+        'distanciaMetros': distancia.round(),
+        'duracaoSegundos': duracao.round(),
+        'polilinha': geometria,
+      };
+    } on TimeoutException {
+      throw const FalhaRota();
+    } on SocketException {
+      throw const FalhaRota();
+    } on http.ClientException {
+      throw const FalhaRota();
+    } on FormatException {
+      throw const FalhaRota();
+    }
+  }
+}
