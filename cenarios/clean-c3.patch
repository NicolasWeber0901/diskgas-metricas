+import '../../domain/entidades/movimentacao_estoque.dart';
+import '../../domain/entidades/tipo_movimentacao.dart';
+
+class MovimentacaoEstoqueModelo {
+  static MovimentacaoEstoque fromMap(String id, Map<String, dynamic> map) {
+    final data = map['data'];
+    return MovimentacaoEstoque(
+      id: id,
+      produtoId: map['produtoId'] as String? ?? '',
+      nomeProduto: map['nomeProduto'] as String? ?? '',
+      tipo: TipoMovimentacao.values.firstWhere(
+        (tipo) => tipo.name == map['tipo'],
+        orElse: () => TipoMovimentacao.entrada,
+      ),
+      quantidade: (map['quantidade'] as num? ?? 0).toInt(),
+      saldo: (map['saldo'] as num? ?? 0).toInt(),
+      data: data is DateTime ? data : DateTime.now(),
+      usuarioId: map['usuarioId'] as String? ?? '',
+      pedidoId: map['pedidoId'] as String?,
+      clienteNome: map['clienteNome'] as String?,
+    );
+  }
+
+  static Map<String, dynamic> toMap(MovimentacaoEstoque movimentacao) {
+    return {
+      'produtoId': movimentacao.produtoId,
+      'nomeProduto': movimentacao.nomeProduto,
+      'tipo': movimentacao.tipo.name,
+      'quantidade': movimentacao.quantidade,
+      'saldo': movimentacao.saldo,
+      'data': movimentacao.data,
+      'usuarioId': movimentacao.usuarioId,
+      if (movimentacao.pedidoId != null) 'pedidoId': movimentacao.pedidoId,
+      if (movimentacao.clienteNome != null)
+        'clienteNome': movimentacao.clienteNome,
+    };
+  }
+}
