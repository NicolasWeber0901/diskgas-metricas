index 0000000..82bed1a
--- /dev/null
+++ b/b/lib/presentation/historico_estoque_viewmodel.dart
@@ -0,0 +1,67 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../domain/casos_de_uso/observar_historico_estoque.dart';
+import '../domain/entidades/movimentacao_estoque.dart';
+import '../domain/falhas.dart';
+
+/// US18: estado do histórico de estoque e o filtro por produto.
+class HistoricoEstoqueViewModel extends ChangeNotifier {
+  final ObservarHistoricoEstoque _observarHistorico;
+  StreamSubscription<List<MovimentacaoEstoque>>? _inscricao;
+
+  List<MovimentacaoEstoque> movimentacoes = [];
+  String? produtoSelecionado;
+  bool carregando = true;
+  String? erro;
+
+  HistoricoEstoqueViewModel(this._observarHistorico);
+
+  void iniciar() {
+    _inscricao = _observarHistorico.executar().listen(
+      (lista) {
+        movimentacoes = lista;
+        carregando = false;
+        erro = null;
+        notifyListeners();
+      },
+      onError: (Object _) {
+        carregando = false;
+        erro = const FalhaConexao().mensagem;
+        notifyListeners();
+      },
+    );
+  }
+
+  List<({String id, String nome})> get produtos {
+    final nomes = <String, String>{
+      for (final movimentacao in movimentacoes)
+        movimentacao.produtoId: movimentacao.nomeProduto,
+    };
+    return [
+      for (final produto in nomes.entries)
+        (id: produto.key, nome: produto.value),
+    ]..sort((a, b) => a.nome.toLowerCase().compareTo(b.nome.toLowerCase()));
+  }
+
+  List<MovimentacaoEstoque> get movimentacoesFiltradas {
+    final produto = produtoSelecionado;
+    if (produto == null) return movimentacoes;
+    return [
+      for (final movimentacao in movimentacoes)
+        if (movimentacao.produtoId == produto) movimentacao,
+    ];
+  }
+
+  void escolherProduto(String? produtoId) {
+    produtoSelecionado = produtoId;
+    notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    _inscricao?.cancel();
+    super.dispose();
+  }
+}
